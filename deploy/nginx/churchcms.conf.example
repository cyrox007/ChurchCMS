# Пример production-конфигурации Nginx для ChurchCMS.
# Перед использованием замените churchcms.example и пути сертификатов.

server {
    listen 80;
    listen [::]:80;
    server_name churchcms.example;

    root /var/www/churchcms;

    location ^~ /.well-known/acme-challenge/ {
        try_files $uri =404;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name churchcms.example;

    root /var/www/churchcms;
    index index.php;
    charset utf-8;

    server_tokens off;
    client_max_body_size 512m;

    ssl_certificate /etc/letsencrypt/live/churchcms.example/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/churchcms.example/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:ChurchCMS_TLS:10m;
    ssl_session_timeout 1d;

    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    # Включайте HSTS только после проверки постоянной работы HTTPS для домена.
    # add_header Strict-Transport-Security "max-age=31536000" always;

    location ~ /\.(?!well-known/) {
        deny all;
    }

    # Внутренние каталоги никогда не выдаются Nginx напрямую.
    location ~ ^/(?:app|bin|config|core|database|deploy|docs|legacy|modules|storage|themes|tools)(?:/|$) {
        deny all;
    }

    # Инсталлятор — единственная отдельная PHP-точка входа.
    # После успешной установки ChurchCMS самостоятельно блокирует повторный запуск.
    location = /install.php {
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root/install.php;
        fastcgi_param SCRIPT_NAME /install.php;
        fastcgi_param HTTPS on;
        fastcgi_param HTTP_PROXY "";
        fastcgi_pass unix:/run/php/php8.3-fpm-churchcms.sock;
        fastcgi_read_timeout 300s;
        fastcgi_hide_header X-Powered-By;
    }

    # Все обычные URL обслуживаются единым front controller.
    location / {
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root/index.php;
        fastcgi_param SCRIPT_NAME /index.php;
        fastcgi_param HTTPS on;
        fastcgi_param HTTP_PROXY "";
        fastcgi_pass unix:/run/php/php8.3-fpm-churchcms.sock;
        fastcgi_read_timeout 300s;
        fastcgi_hide_header X-Powered-By;
    }

    # Любые другие прямые обращения к *.php запрещены.
    location ~ \.php$ {
        return 404;
    }
}
