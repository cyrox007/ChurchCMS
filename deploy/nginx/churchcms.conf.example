# ChurchCMS reference Nginx profile
# Adjust server_name, root and PHP-FPM socket for the target host.

server {
    listen 80;
    server_name churchcms.example;
    root /var/www/churchcms;
    index index.php;

    location ~ ^/(?:config|storage|legacy|docs|\.git)(?:/|$) {
        deny all;
        return 404;
    }

    location ~* ^/themes/.+\.(?:css|js|png|jpe?g|gif|svg|webp|ico|woff2?)$ {
        try_files $uri =404;
        access_log off;
    }

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location = /index.php {
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root/index.php;
        fastcgi_param HTTP_PROXY "";
        fastcgi_pass unix:/run/php/php8.3-fpm.sock;
        fastcgi_hide_header X-Powered-By;
    }

    location ~ \.php$ {
        return 404;
    }
}
